{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Strukturpiloten/boxferry//renovate-presets/common#cf3578f47416e1b27b770fe4a81918844fb2d58b",
    "github>Strukturpiloten/boxferry//renovate-presets/rust#cf3578f47416e1b27b770fe4a81918844fb2d58b"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/fixtures/**"
  ],
  "customDatasources": {
    "fedora-podman": {
      "defaultRegistryUrlTemplate": "https://bodhi.fedoraproject.org/updates/?packages=podman&releases=F45&status=stable&rows_per_page=100",
      "transformTemplates": [
        "{\"releases\": [updates[status = 'stable' and release.name = 'F45' and $exists(date_stable)].($update := $; builds[signed = true and epoch = 5 and $contains(nvr, /^podman-6\\.1\\.[0-9]+-[1-9][0-9]*(\\.[0-9]+)?\\.fc45$/)].{\"version\": $substringAfter(nvr, 'podman-'), \"releaseTimestamp\": $replace($update.date_stable, ' ', 'T') & 'Z', \"changelogUrl\": $update.url})]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nARG [A-Z0-9_]+_VERSION=(?<currentValue>[^\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\s+version: \\\"(?<currentValue>[^\\\"]+)\\\"",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\s+node-version: (?<currentValue>[^\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": ["Track signed stable Fedora Podman builds, including same-version rebuilds"],
      "managerFilePatterns": ["/^scripts/native-runtime-pins\\.sh$/"],
      "matchStrings": [
        "readonly PODMAN_NATIVE_RPM_BUILD=(?<currentValue>6\\.1\\.[0-9]+-[1-9][0-9]*(?:\\.[0-9]+)?\\.fc45)\\n"
      ],
      "datasourceTemplate": "custom.fedora-podman",
      "depNameTemplate": "podman-fedora-45",
      "versioningTemplate": "regex:^(?<major>6)\\.(?<minor>1)\\.(?<patch>[0-9]+)-(?<build>[1-9][0-9]*)(?:\\.(?<revision>[0-9]+))?\\.fc45$"
    },
    {
      "customType": "regex",
      "description": ["Track the native Fedora base tag and manifest for qualification"],
      "managerFilePatterns": ["/^scripts/native-runtime-pins\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>registry\\.fedoraproject\\.org/fedora)\\nreadonly PODMAN_NATIVE_BASE_IMAGE=registry\\.fedoraproject\\.org/fedora:(?<currentValue>[0-9]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": ["Update the Dev Container base release and digest together"],
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n# release: (?<currentValue>[^\\s]+)\\nFROM [^\\s]+@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}\n# release: {{{newValue}}}\nFROM {{{depName}}}:{{{newValue}}}@{{{newDigest}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.devcontainer/devcontainer\\.json$/"],
      "matchStrings": [
        "\\\"ghcr\\.io/devcontainers/features/github-cli:[^\\\"]+\\\"[\\s\\S]*?\\\"version\\\": \\\"(?<currentValue>[^\\\"]+)\\\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "cli/cli"
    }
  ],
  "packageRules": [
    {
      "description": [
        "Propose the Fedora build and its upstream Podman patch for integrity review"
      ],
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["scripts/native-runtime-pins.sh"],
      "matchDatasources": ["custom.fedora-podman"],
      "matchPackageNames": ["podman-fedora-45"],
      "automerge": false,
      "prBodyNotes": [
        "Verify both signed Fedora RPMs, the upstream tag and archive, and refresh the associated integrity pins before rootful and rootless qualification."
      ]
    },
    {
      "description": ["Propose immutable Fedora 45 base manifest updates for native review"],
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["scripts/native-runtime-pins.sh"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["registry.fedoraproject.org/fedora"],
      "allowedVersions": "/^45$/",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": ["Hold direct Dev Container inputs until separate image qualification #563"],
      "matchFileNames": [
        ".devcontainer/Dockerfile",
        ".devcontainer/devcontainer.json",
        ".devcontainer/devcontainer-lock.json"
      ],
      "enabled": false
    },
    {
      "description": [
        "Keep candidate-owned coverage tooling automatic without qualifying the image"
      ],
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["crate"],
      "matchFileNames": [".devcontainer/Dockerfile"],
      "matchPackageNames": ["cargo-llvm-cov"],
      "enabled": true
    }
  ]
}
