{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Offline PodmanLens Python tooling configuration",
  "description": "Ruff and ty check tool semantics in the complete gate; this local schema avoids unavailable embedded remote references.",
  "type": "object",
  "required": ["tool"],
  "additionalProperties": false,
  "properties": {
    "tool": {
      "type": "object",
      "required": ["ruff", "ty"],
      "additionalProperties": false,
      "properties": {
        "ruff": {
          "type": "object",
          "required": ["target-version", "line-length", "lint"],
          "additionalProperties": false,
          "properties": {
            "target-version": {
              "type": "string",
              "pattern": "^py[0-9]+$"
            },
            "line-length": {
              "type": "integer",
              "minimum": 1
            },
            "lint": {
              "type": "object",
              "required": ["select"],
              "additionalProperties": false,
              "properties": {
                "select": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z]+[0-9]*$"
                  }
                }
              }
            }
          }
        },
        "ty": {
          "type": "object",
          "required": ["environment", "terminal"],
          "additionalProperties": false,
          "properties": {
            "environment": {
              "type": "object",
              "required": ["python-version"],
              "additionalProperties": false,
              "properties": {
                "python-version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+$"
                }
              }
            },
            "terminal": {
              "type": "object",
              "required": ["error-on-warning"],
              "additionalProperties": false,
              "properties": {
                "error-on-warning": {
                  "const": true
                }
              }
            }
          }
        }
      }
    }
  }
}
