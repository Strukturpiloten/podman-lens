{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boxferry.dev/schemas/podman-lens-snapshot-v1.schema.json",
  "title": "PodmanLens snapshot v1",
  "description": "Serialization-only, always-redacted inventory or discovery graph snapshot.",
  "oneOf": [
    {
      "$ref": "#/$defs/inventory"
    },
    {
      "$ref": "#/$defs/graph"
    }
  ],
  "$defs": {
    "schema_version": {
      "const": 1
    },
    "resource_kind": {
      "enum": ["container", "pod", "network", "volume", "image", "secret"]
    },
    "observation_field_state": {
      "enum": [
        "absent",
        "observed",
        "unavailable",
        "malformed",
        "version_inapplicable",
        "not_applicable",
        "unmodelled"
      ]
    },
    "observation_origin": {
      "enum": ["configured", "effective", "runtime_assigned", "local_resolution"]
    },
    "identity": {
      "type": "object",
      "required": ["kind", "id", "name"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/resource_kind"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "resource_selector": {
      "type": "object",
      "required": ["kind", "reference"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/resource_kind"
        },
        "reference": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "label_selector": {
      "type": "object",
      "required": ["name", "exact_value_requested"],
      "properties": {
        "name": {
          "type": "string"
        },
        "exact_value_requested": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": ["engine", "api", "target_podman", "target_api"],
      "properties": {
        "engine": {
          "type": "string"
        },
        "api": {
          "type": "string"
        },
        "target_podman": {
          "type": "string"
        },
        "target_api": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "engine_version",
        "api_version",
        "podman_minor_line",
        "minimum_podman_version",
        "maximum_exclusive_podman_version",
        "minimum_libpod_api_version",
        "observed_podman_version",
        "observed_libpod_api_version",
        "evidence_source",
        "evidence_revision",
        "evidence_release_tag"
      ],
      "properties": {
        "engine_version": {
          "type": "string"
        },
        "api_version": {
          "type": "string"
        },
        "podman_minor_line": {
          "type": "string"
        },
        "minimum_podman_version": {
          "type": "string"
        },
        "maximum_exclusive_podman_version": {
          "type": "string"
        },
        "minimum_libpod_api_version": {
          "type": "string"
        },
        "observed_podman_version": {
          "type": "string"
        },
        "observed_libpod_api_version": {
          "type": "string"
        },
        "evidence_source": {
          "type": "string",
          "format": "uri"
        },
        "evidence_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "evidence_release_tag": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "field_state": {
      "type": "object",
      "required": ["state", "origin"],
      "properties": {
        "state": {
          "$ref": "#/$defs/observation_field_state"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/observation_origin"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "origin": {
                "$ref": "#/$defs/observation_origin"
              }
            }
          },
          "else": {
            "properties": {
              "origin": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "field_count": {
      "type": "object",
      "required": ["state", "origin", "count"],
      "properties": {
        "state": {
          "$ref": "#/$defs/observation_field_state"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/observation_origin"
            },
            {
              "type": "null"
            }
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "origin": {
                "$ref": "#/$defs/observation_origin"
              }
            }
          },
          "else": {
            "properties": {
              "origin": {
                "type": "null"
              },
              "count": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "environment_entry": {
      "type": "object",
      "required": ["name", "value_state"],
      "properties": {
        "name": {
          "type": "string"
        },
        "value_state": {
          "enum": ["redacted", "authorized_opaque_redacted"]
        }
      },
      "additionalProperties": false
    },
    "protected_environment": {
      "type": "object",
      "required": ["state", "origin", "entries"],
      "properties": {
        "state": {
          "$ref": "#/$defs/observation_field_state"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/observation_origin"
            },
            {
              "type": "null"
            }
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/environment_entry"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "origin": {
                "$ref": "#/$defs/observation_origin"
              }
            }
          },
          "else": {
            "properties": {
              "origin": {
                "type": "null"
              },
              "entries": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "network": {
      "type": "object",
      "required": ["internal", "options", "subnets", "routes"],
      "properties": {
        "internal": {
          "$ref": "#/$defs/field_state"
        },
        "options": {
          "$ref": "#/$defs/field_count"
        },
        "subnets": {
          "$ref": "#/$defs/field_count"
        },
        "routes": {
          "$ref": "#/$defs/field_count"
        }
      },
      "additionalProperties": false
    },
    "native_networking": {
      "type": "object",
      "required": [
        "port_bindings",
        "create_net_ns",
        "host_network",
        "dns_servers",
        "dns_search",
        "dns_options",
        "host_entries",
        "networks",
        "network_options",
        "no_manage_resolv_conf",
        "no_manage_hosts",
        "static_ip",
        "static_mac"
      ],
      "properties": {
        "port_bindings": {
          "$ref": "#/$defs/field_count"
        },
        "create_net_ns": {
          "$ref": "#/$defs/field_state"
        },
        "host_network": {
          "$ref": "#/$defs/field_state"
        },
        "dns_servers": {
          "$ref": "#/$defs/field_count"
        },
        "dns_search": {
          "$ref": "#/$defs/field_count"
        },
        "dns_options": {
          "$ref": "#/$defs/field_count"
        },
        "host_entries": {
          "$ref": "#/$defs/field_state"
        },
        "networks": {
          "$ref": "#/$defs/field_count"
        },
        "network_options": {
          "$ref": "#/$defs/field_count"
        },
        "no_manage_resolv_conf": {
          "$ref": "#/$defs/field_state"
        },
        "no_manage_hosts": {
          "$ref": "#/$defs/field_state"
        },
        "static_ip": {
          "$ref": "#/$defs/field_state"
        },
        "static_mac": {
          "$ref": "#/$defs/field_state"
        }
      },
      "additionalProperties": false
    },
    "unmodelled_field": {
      "type": "object",
      "required": ["id", "path", "json_kind", "resource", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^podman\\.native\\.[a-z0-9-]+(?:\\.[a-z0-9-]+)*$"
        },
        "path": {
          "type": "string"
        },
        "json_kind": {
          "enum": ["null", "boolean", "number", "string", "array", "object"]
        },
        "resource": {
          "$ref": "#/$defs/identity"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "additionalProperties": false
    },
    "inventory_finding": {
      "type": "object",
      "required": ["code", "resource", "field_path", "occurrence"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^PLN[0-9]{4}$"
        },
        "resource": {
          "anyOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "field_path": {
          "type": ["string", "null"]
        },
        "occurrence": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "volume_owner": {
      "type": "object",
      "required": ["state", "origin", "wire_value"],
      "properties": {
        "state": {
          "$ref": "#/$defs/observation_field_state"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/observation_origin"
            },
            {
              "type": "null"
            }
          ]
        },
        "wire_value": {
          "anyOf": [
            {
              "enum": ["wire_absent_may_mean_zero", "explicit"]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "origin": {
                "$ref": "#/$defs/observation_origin"
              },
              "wire_value": {
                "enum": ["wire_absent_may_mean_zero", "explicit"]
              }
            }
          },
          "else": {
            "properties": {
              "origin": {
                "type": "null"
              },
              "wire_value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "detail_base": {
      "type": "object",
      "required": [
        "kind",
        "labels",
        "configured_image",
        "local_image_id",
        "relationships",
        "environment",
        "command",
        "entrypoint",
        "user",
        "working_directory",
        "hostname",
        "pod_membership",
        "native_dependencies",
        "mounts",
        "secret_grants",
        "image_aliases",
        "network",
        "networking",
        "memory_swappiness",
        "infra",
        "create_infra",
        "secret_driver",
        "volume_uid",
        "volume_gid",
        "restart_policy",
        "health_check",
        "health_failure_action",
        "startup_health_check",
        "logging"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/resource_kind"
        },
        "labels": {
          "$ref": "#/$defs/field_count"
        },
        "configured_image": {
          "anyOf": [
            {
              "$ref": "#/$defs/field_state"
            },
            {
              "type": "null"
            }
          ]
        },
        "local_image_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/field_state"
            },
            {
              "type": "null"
            }
          ]
        },
        "relationships": {
          "anyOf": [
            {
              "$ref": "#/$defs/field_count"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment": {
          "anyOf": [
            {
              "$ref": "#/$defs/protected_environment"
            },
            {
              "type": "null"
            }
          ]
        },
        "command": {
          "anyOf": [
            {
              "$ref": "#/$defs/field_count"
            },
            {
              "type": "null"
            }
          ]
        },
        "entrypoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/field_count"
            },
            {
              "type": "null"
            }
          ]
        },
        "user": {
          "anyOf": [
            {
              "$ref": "#/$defs/field_state"
            },
            {
              "type": "null"
            }
          ]
        },
        "working_directory": {
          "anyOf": [
            {
              "$ref": "#/$defs/field_state"
            },
            {
              "type": "null"
            }
          ]
        },
        "hostname": {
          "anyOf": [
            {
              "$ref": "#/$defs/field_state"
            },
            {
              "type": "null"
            }
          ]
        },
        "pod_membership": {
          "anyOf": [
            {
              "$ref": "#/$defs/field_state"
            },
            {
              "type": "null"
            }
          ]
        },
        "native_dependencies": {
          "anyOf": [
            {
              "$ref": "#/$defs/field_count"
            },
            {
              "type": "null"
            }
          ]
        },
        "mounts": {
          "anyOf": [
            {
              "$ref": "#/$defs/field_count"
            },
            {
              "type": "null"
            }
          ]
        },
        "secret_grants": {
          "anyOf": [
            {
              "$ref": "#/$defs/field_count"
            },
            {
              "type": "null"
            }
          ]
        },
        "image_aliases": {
          "anyOf": [
            {
              "$ref": "#/$defs/field_count"
            },
            {
              "type": "null"
            }
          ]
        },
        "network": {
          "anyOf": [
            {
              "$ref": "#/$defs/network"
            },
            {
              "type": "null"
            }
          ]
        },
        "networking": {
          "anyOf": [
            {
              "$ref": "#/$defs/native_networking"
            },
            {
              "type": "null"
            }
          ]
        },
        "memory_swappiness": {
          "anyOf": [
            {
              "$ref": "#/$defs/field_state"
            },
            {
              "type": "null"
            }
          ]
        },
        "infra": {
          "anyOf": [
            {
              "$ref": "#/$defs/field_state"
            },
            {
              "type": "null"
            }
          ]
        },
        "create_infra": {
          "anyOf": [
            {
              "$ref": "#/$defs/field_state"
            },
            {
              "type": "null"
            }
          ]
        },
        "secret_driver": {
          "anyOf": [
            {
              "$ref": "#/$defs/field_state"
            },
            {
              "type": "null"
            }
          ]
        },
        "volume_uid": {
          "anyOf": [
            {
              "$ref": "#/$defs/volume_owner"
            },
            {
              "type": "null"
            }
          ]
        },
        "volume_gid": {
          "anyOf": [
            {
              "$ref": "#/$defs/volume_owner"
            },
            {
              "type": "null"
            }
          ]
        },
        "restart_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/native_restart_policy"
            },
            {
              "type": "null"
            }
          ]
        },
        "health_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/native_health_check"
            },
            {
              "type": "null"
            }
          ]
        },
        "health_failure_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/field_state"
            },
            {
              "type": "null"
            }
          ]
        },
        "startup_health_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/native_startup_health_check"
            },
            {
              "type": "null"
            }
          ]
        },
        "logging": {
          "anyOf": [
            {
              "$ref": "#/$defs/native_logging"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "container_details": {
      "allOf": [
        {
          "$ref": "#/$defs/detail_base"
        },
        {
          "properties": {
            "kind": {
              "const": "container"
            },
            "configured_image": {
              "$ref": "#/$defs/field_state"
            },
            "local_image_id": {
              "$ref": "#/$defs/field_state"
            },
            "relationships": {
              "$ref": "#/$defs/field_count"
            },
            "environment": {
              "$ref": "#/$defs/protected_environment"
            },
            "command": {
              "$ref": "#/$defs/field_count"
            },
            "entrypoint": {
              "$ref": "#/$defs/field_count"
            },
            "user": {
              "$ref": "#/$defs/field_state"
            },
            "working_directory": {
              "$ref": "#/$defs/field_state"
            },
            "hostname": {
              "$ref": "#/$defs/field_state"
            },
            "pod_membership": {
              "$ref": "#/$defs/field_state"
            },
            "native_dependencies": {
              "$ref": "#/$defs/field_count"
            },
            "mounts": {
              "$ref": "#/$defs/field_count"
            },
            "secret_grants": {
              "$ref": "#/$defs/field_count"
            },
            "memory_swappiness": {
              "$ref": "#/$defs/field_state"
            },
            "infra": {
              "$ref": "#/$defs/field_state"
            },
            "image_aliases": {
              "type": "null"
            },
            "network": {
              "type": "null"
            },
            "networking": {
              "$ref": "#/$defs/native_networking"
            },
            "create_infra": {
              "type": "null"
            },
            "secret_driver": {
              "type": "null"
            },
            "volume_uid": {
              "type": "null"
            },
            "volume_gid": {
              "type": "null"
            },
            "restart_policy": {
              "$ref": "#/$defs/native_restart_policy"
            },
            "health_check": {
              "$ref": "#/$defs/native_health_check"
            },
            "health_failure_action": {
              "$ref": "#/$defs/field_state"
            },
            "startup_health_check": {
              "$ref": "#/$defs/native_startup_health_check"
            },
            "logging": {
              "$ref": "#/$defs/native_logging"
            }
          }
        }
      ]
    },
    "pod_details": {
      "allOf": [
        {
          "$ref": "#/$defs/detail_base"
        },
        {
          "properties": {
            "kind": {
              "const": "pod"
            },
            "relationships": {
              "$ref": "#/$defs/field_count"
            },
            "configured_image": {
              "type": "null"
            },
            "local_image_id": {
              "type": "null"
            },
            "environment": {
              "type": "null"
            },
            "command": {
              "type": "null"
            },
            "entrypoint": {
              "type": "null"
            },
            "user": {
              "type": "null"
            },
            "working_directory": {
              "type": "null"
            },
            "hostname": {
              "type": "null"
            },
            "pod_membership": {
              "type": "null"
            },
            "native_dependencies": {
              "type": "null"
            },
            "mounts": {
              "type": "null"
            },
            "secret_grants": {
              "type": "null"
            },
            "image_aliases": {
              "type": "null"
            },
            "network": {
              "type": "null"
            },
            "networking": {
              "$ref": "#/$defs/native_networking"
            },
            "memory_swappiness": {
              "type": "null"
            },
            "infra": {
              "type": "null"
            },
            "create_infra": {
              "$ref": "#/$defs/field_state"
            },
            "secret_driver": {
              "type": "null"
            },
            "volume_uid": {
              "type": "null"
            },
            "volume_gid": {
              "type": "null"
            },
            "restart_policy": {
              "type": "null"
            },
            "health_check": {
              "type": "null"
            },
            "health_failure_action": {
              "type": "null"
            },
            "startup_health_check": {
              "type": "null"
            },
            "logging": {
              "type": "null"
            }
          }
        }
      ]
    },
    "network_details": {
      "allOf": [
        {
          "$ref": "#/$defs/detail_base"
        },
        {
          "properties": {
            "kind": {
              "const": "network"
            },
            "network": {
              "$ref": "#/$defs/network"
            },
            "networking": {
              "type": "null"
            },
            "configured_image": {
              "type": "null"
            },
            "local_image_id": {
              "type": "null"
            },
            "relationships": {
              "type": "null"
            },
            "environment": {
              "type": "null"
            },
            "command": {
              "type": "null"
            },
            "entrypoint": {
              "type": "null"
            },
            "user": {
              "type": "null"
            },
            "working_directory": {
              "type": "null"
            },
            "hostname": {
              "type": "null"
            },
            "pod_membership": {
              "type": "null"
            },
            "native_dependencies": {
              "type": "null"
            },
            "mounts": {
              "type": "null"
            },
            "secret_grants": {
              "type": "null"
            },
            "image_aliases": {
              "type": "null"
            },
            "memory_swappiness": {
              "type": "null"
            },
            "infra": {
              "type": "null"
            },
            "create_infra": {
              "type": "null"
            },
            "secret_driver": {
