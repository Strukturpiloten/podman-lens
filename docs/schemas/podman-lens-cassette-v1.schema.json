{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boxferry.dev/schemas/podman-lens-cassette-v1.schema.json",
  "title": "PodmanLens request-aware Libpod cassette v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_kind",
    "scenario_id",
    "scenario_revision",
    "engine_version",
    "api_version",
    "execution_context",
    "synthetic",
    "provenance",
    "sanitization",
    "interactions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "fixture_kind": {
      "const": "libpod-cassette"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "scenario_revision": {
      "type": "integer",
      "minimum": 1
    },
    "engine_version": {
      "$ref": "#/$defs/version"
    },
    "api_version": {
      "$ref": "#/$defs/version"
    },
    "execution_context": {
      "enum": ["rootless", "rootful"]
    },
    "synthetic": {
      "type": "boolean"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "sanitization": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "interactions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/interaction"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "synthetic": {
            "const": false
          }
        },
        "required": ["synthetic"]
      },
      "then": {
        "properties": {
          "provenance": {
            "required": ["capture"]
          }
        }
      },
      "else": {
        "properties": {
          "provenance": {
            "not": {
              "required": ["capture"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_kind", "release_tag", "revision", "source_urls"],
      "properties": {
        "evidence_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "release_tag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://\\S+$"
          }
        },
        "capture": {
          "$ref": "#/$defs/capture"
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_build",
        "runtime_image",
        "capture_manifest_sha256",
        "runtime_repository",
        "runtime_revision",
        "runtime_matrix_cell",
        "runtime_matrix_sha256",
        "setup_script_sha256",
        "request_recorder_source_sha256"
      ],
      "properties": {
        "engine_build": {
          "$ref": "#/$defs/engine_build"
        },
        "runtime_image": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^\\S+@sha256:[0-9a-f]{64}$"
        },
        "capture_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime_repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "runtime_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "runtime_matrix_cell": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "runtime_matrix_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "setup_script_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_recorder_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "compose_provider_binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "response"],
      "properties": {
        "request": {
          "$ref": "#/$defs/request"
        },
        "response": {
          "$ref": "#/$defs/response"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": {
          "const": "GET"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/\\S*$"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "headers"],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              {
                "type": "string"
              }
            ],
            "items": false
          }
        },
        "body": true,
        "body_text": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "oneOf": [
        {
          "required": ["body"],
          "not": {
            "required": ["body_text"]
          }
        },
        {
          "required": ["body_text"],
          "not": {
            "required": ["body"]
          }
        }
      ]
    },
    "engine_build": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source_revision"],
          "properties": {
            "kind": {
              "const": "source-build"
            },
            "source_revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "package_name", "package_revision", "package_artifact_sha256"],
          "properties": {
            "kind": {
              "const": "package"
            },
            "package_name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$"
            },
            "package_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^\\S+$"
            },
            "package_artifact_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    }
  }
}
