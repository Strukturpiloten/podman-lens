            {
              "type": "null"
            }
          ]
        },
        "field_path": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "root_origin": {
      "type": "object",
      "required": ["kind", "position"],
      "properties": {
        "kind": {
          "enum": ["resource_selector", "label_selector", "all"]
