        "position": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "explanation": {
      "type": "object",
      "required": ["kind", "resource", "related", "position", "root_origin"],
      "properties": {
        "kind": {
          "enum": [
            "root",
            "included_member",
            "prerequisite",
            "stopped_shared_boundary",
            "authorized_network_crossing",
            "authorized_shared_crossing",
            "strong_evidence_merge",
            "group_ordering"
          ]
        },
        "resource": {
          "$ref": "#/$defs/identity"
        },
        "related": {
          "anyOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "position": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "root_origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/root_origin"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
