    "observation_header": {
      "type": "object",
      "required": [
        "identity",
        "state",
        "unmodelled_completeness",
        "unmodelled_fields",
        "findings",
        "evidence"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "state": {
          "enum": ["complete", "unavailable", "malformed"]
        },
        "unmodelled_completeness": {
          "enum": ["complete", "incomplete"]
        },
        "unmodelled_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unmodelled_field"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inventory_finding"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["header", "details"],
      "properties": {
        "header": {
          "$ref": "#/$defs/observation_header"
        },
        "details": {
          "$ref": "#/$defs/details"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "header": {
                "properties": {
                  "identity": {
                    "properties": {
                      "kind": {
                        "const": "container"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "details": {
                "properties": {
                  "kind": {
                    "const": "container"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "header": {
                "properties": {
                  "identity": {
                    "properties": {
                      "kind": {
                        "const": "pod"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "details": {
                "properties": {
                  "kind": {
                    "const": "pod"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "header": {
                "properties": {
                  "identity": {
                    "properties": {
                      "kind": {
                        "const": "network"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "details": {
                "properties": {
                  "kind": {
                    "const": "network"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "header": {
                "properties": {
                  "identity": {
                    "properties": {
                      "kind": {
                        "const": "volume"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "details": {
                "properties": {
                  "kind": {
                    "const": "volume"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "header": {
                "properties": {
                  "identity": {
                    "properties": {
                      "kind": {
                        "const": "image"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "details": {
                "properties": {
                  "kind": {
                    "const": "image"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "header": {
                "properties": {
                  "identity": {
                    "properties": {
                      "kind": {
                        "const": "secret"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "details": {
                "properties": {
                  "kind": {
                    "const": "secret"
                  }
                }
              }
            }
          }
        }
      ]
    },
