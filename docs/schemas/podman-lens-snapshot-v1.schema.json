{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boxferry.dev/schemas/podman-lens-snapshot-v1.schema.json",
  "title": "PodmanLens snapshot v1",
  "description": "Serialization-only, always-redacted inventory or discovery graph snapshot.",
  "oneOf": [{ "$ref": "#/$defs/inventory" }, { "$ref": "#/$defs/graph" }],
  "$defs": {
    "schema_version": { "const": 1 },
    "resource_kind": { "enum": ["container", "pod", "network", "volume", "image", "secret"] },
    "observation_field_state": {
      "enum": [
        "absent",
        "observed",
        "unavailable",
        "malformed",
        "version_inapplicable",
        "not_applicable",
        "unmodelled"
      ]
    },
    "observation_origin": {
      "enum": ["configured", "effective", "runtime_assigned", "local_resolution"]
    },
    "identity": {
      "type": "object",
      "required": ["kind", "id", "name"],
      "properties": {
        "kind": { "$ref": "#/$defs/resource_kind" },
        "id": { "type": "string" },
        "name": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "resource_selector": {
      "type": "object",
      "required": ["kind", "reference"],
      "properties": {
        "kind": { "$ref": "#/$defs/resource_kind" },
        "reference": { "type": "string" }
      },
      "additionalProperties": false
    },
    "label_selector": {
      "type": "object",
      "required": ["name", "exact_value_requested"],
      "properties": {
        "name": { "type": "string" },
        "exact_value_requested": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": ["engine", "api", "target_podman", "target_api"],
      "properties": {
        "engine": { "type": "string" },
        "api": { "type": "string" },
        "target_podman": { "type": "string" },
        "target_api": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "engine_version",
        "api_version",
        "podman_minor_line",
        "minimum_podman_version",
        "maximum_exclusive_podman_version",
        "minimum_libpod_api_version",
        "observed_podman_version",
        "observed_libpod_api_version",
        "evidence_source",
        "evidence_revision",
        "evidence_release_tag"
      ],
      "properties": {
        "engine_version": { "type": "string" },
        "api_version": { "type": "string" },
        "podman_minor_line": { "type": "string" },
        "minimum_podman_version": { "type": "string" },
        "maximum_exclusive_podman_version": { "type": "string" },
        "minimum_libpod_api_version": { "type": "string" },
        "observed_podman_version": { "type": "string" },
        "observed_libpod_api_version": { "type": "string" },
        "evidence_source": { "type": "string", "format": "uri" },
        "evidence_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "evidence_release_tag": { "type": "string" }
      },
      "additionalProperties": false
    },
    "field_state": {
      "type": "object",
      "required": ["state", "origin"],
      "properties": {
        "state": { "$ref": "#/$defs/observation_field_state" },
        "origin": { "anyOf": [{ "$ref": "#/$defs/observation_origin" }, { "type": "null" }] }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "observed" } } },
          "then": { "properties": { "origin": { "$ref": "#/$defs/observation_origin" } } },
          "else": { "properties": { "origin": { "type": "null" } } }
        }
      ]
    },
    "field_count": {
      "type": "object",
      "required": ["state", "origin", "count"],
      "properties": {
        "state": { "$ref": "#/$defs/observation_field_state" },
        "origin": { "anyOf": [{ "$ref": "#/$defs/observation_origin" }, { "type": "null" }] },
        "count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "observed" } } },
          "then": { "properties": { "origin": { "$ref": "#/$defs/observation_origin" } } },
          "else": { "properties": { "origin": { "type": "null" }, "count": { "const": 0 } } }
        }
      ]
    },
    "environment_entry": {
      "type": "object",
      "required": ["name", "value_state"],
      "properties": {
        "name": { "type": "string" },
        "value_state": { "enum": ["redacted", "authorized_opaque_redacted"] }
      },
      "additionalProperties": false
    },
    "protected_environment": {
      "type": "object",
      "required": ["state", "origin", "entries"],
      "properties": {
        "state": { "$ref": "#/$defs/observation_field_state" },
        "origin": { "anyOf": [{ "$ref": "#/$defs/observation_origin" }, { "type": "null" }] },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/environment_entry" } }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "observed" } } },
          "then": { "properties": { "origin": { "$ref": "#/$defs/observation_origin" } } },
          "else": { "properties": { "origin": { "type": "null" }, "entries": { "maxItems": 0 } } }
        }
      ]
    },
    "network": {
      "type": "object",
      "required": ["internal", "options", "subnets"],
      "properties": {
        "internal": { "$ref": "#/$defs/field_state" },
        "options": { "$ref": "#/$defs/field_count" },
        "subnets": { "$ref": "#/$defs/field_count" }
      },
      "additionalProperties": false
    },
    "unmodelled_field": {
      "type": "object",
      "required": ["id", "path", "json_kind", "resource", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^podman\\.native\\.[a-z0-9-]+(?:\\.[a-z0-9-]+)*$" },
        "path": { "type": "string" },
        "json_kind": { "enum": ["null", "boolean", "number", "string", "array", "object"] },
        "resource": { "$ref": "#/$defs/identity" },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "additionalProperties": false
    },
    "inventory_finding": {
      "type": "object",
      "required": ["code", "resource", "field_path", "occurrence"],
      "properties": {
        "code": { "type": "string", "pattern": "^PLN[0-9]{4}$" },
        "resource": { "anyOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
        "field_path": { "type": ["string", "null"] },
        "occurrence": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "volume_owner": {
      "type": "object",
      "required": ["state", "origin", "wire_value"],
      "properties": {
        "state": { "$ref": "#/$defs/observation_field_state" },
        "origin": { "anyOf": [{ "$ref": "#/$defs/observation_origin" }, { "type": "null" }] },
        "wire_value": {
          "anyOf": [{ "enum": ["wire_absent_may_mean_zero", "explicit"] }, { "type": "null" }]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "observed" } } },
          "then": {
            "properties": {
              "origin": { "$ref": "#/$defs/observation_origin" },
              "wire_value": { "enum": ["wire_absent_may_mean_zero", "explicit"] }
            }
          },
          "else": {
            "properties": { "origin": { "type": "null" }, "wire_value": { "type": "null" } }
          }
        }
      ]
    },
    "detail_base": {
      "type": "object",
      "required": [
        "kind",
        "labels",
        "configured_image",
        "local_image_id",
        "relationships",
        "environment",
        "image_aliases",
        "network",
        "memory_swappiness",
        "infra",
        "secret_driver",
        "volume_uid",
        "volume_gid"
      ],
      "properties": {
        "kind": { "$ref": "#/$defs/resource_kind" },
        "labels": { "$ref": "#/$defs/field_count" },
        "configured_image": { "anyOf": [{ "$ref": "#/$defs/field_state" }, { "type": "null" }] },
        "local_image_id": { "anyOf": [{ "$ref": "#/$defs/field_state" }, { "type": "null" }] },
        "relationships": { "anyOf": [{ "$ref": "#/$defs/field_count" }, { "type": "null" }] },
        "environment": {
          "anyOf": [{ "$ref": "#/$defs/protected_environment" }, { "type": "null" }]
        },
        "image_aliases": { "anyOf": [{ "$ref": "#/$defs/field_count" }, { "type": "null" }] },
        "network": { "anyOf": [{ "$ref": "#/$defs/network" }, { "type": "null" }] },
        "memory_swappiness": { "anyOf": [{ "$ref": "#/$defs/field_state" }, { "type": "null" }] },
        "infra": { "anyOf": [{ "$ref": "#/$defs/field_state" }, { "type": "null" }] },
        "secret_driver": { "anyOf": [{ "$ref": "#/$defs/field_state" }, { "type": "null" }] },
        "volume_uid": { "anyOf": [{ "$ref": "#/$defs/volume_owner" }, { "type": "null" }] },
        "volume_gid": { "anyOf": [{ "$ref": "#/$defs/volume_owner" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "container_details": {
      "allOf": [
        { "$ref": "#/$defs/detail_base" },
        {
          "properties": {
            "kind": { "const": "container" },
            "configured_image": { "$ref": "#/$defs/field_state" },
            "local_image_id": { "$ref": "#/$defs/field_state" },
            "relationships": { "$ref": "#/$defs/field_count" },
            "environment": { "$ref": "#/$defs/protected_environment" },
            "memory_swappiness": { "$ref": "#/$defs/field_state" },
            "infra": { "$ref": "#/$defs/field_state" },
            "image_aliases": { "type": "null" },
            "network": { "type": "null" },
            "secret_driver": { "type": "null" },
            "volume_uid": { "type": "null" },
            "volume_gid": { "type": "null" }
          }
        }
      ]
    },
    "pod_details": {
      "allOf": [
        { "$ref": "#/$defs/detail_base" },
        {
          "properties": {
            "kind": { "const": "pod" },
            "relationships": { "$ref": "#/$defs/field_count" },
            "configured_image": { "type": "null" },
            "local_image_id": { "type": "null" },
            "environment": { "type": "null" },
            "image_aliases": { "type": "null" },
            "network": { "type": "null" },
            "memory_swappiness": { "type": "null" },
            "infra": { "type": "null" },
            "secret_driver": { "type": "null" },
            "volume_uid": { "type": "null" },
            "volume_gid": { "type": "null" }
          }
        }
      ]
    },
    "network_details": {
      "allOf": [
        { "$ref": "#/$defs/detail_base" },
        {
          "properties": {
            "kind": { "const": "network" },
            "network": { "$ref": "#/$defs/network" },
            "configured_image": { "type": "null" },
            "local_image_id": { "type": "null" },
            "relationships": { "type": "null" },
            "environment": { "type": "null" },
            "image_aliases": { "type": "null" },
            "memory_swappiness": { "type": "null" },
            "infra": { "type": "null" },
            "secret_driver": { "type": "null" },
            "volume_uid": { "type": "null" },
            "volume_gid": { "type": "null" }
          }
        }
      ]
    },
    "volume_details": {
      "allOf": [
        { "$ref": "#/$defs/detail_base" },
        {
          "properties": {
            "kind": { "const": "volume" },
            "volume_uid": { "$ref": "#/$defs/volume_owner" },
            "volume_gid": { "$ref": "#/$defs/volume_owner" },
            "configured_image": { "type": "null" },
            "local_image_id": { "type": "null" },
            "relationships": { "type": "null" },
            "environment": { "type": "null" },
            "image_aliases": { "type": "null" },
            "network": { "type": "null" },
            "memory_swappiness": { "type": "null" },
            "infra": { "type": "null" },
            "secret_driver": { "type": "null" }
          }
        }
      ]
    },
    "image_details": {
      "allOf": [
        { "$ref": "#/$defs/detail_base" },
        {
          "properties": {
            "kind": { "const": "image" },
            "environment": { "$ref": "#/$defs/protected_environment" },
            "image_aliases": { "$ref": "#/$defs/field_count" },
            "configured_image": { "type": "null" },
            "local_image_id": { "type": "null" },
            "relationships": { "type": "null" },
            "network": { "type": "null" },
            "memory_swappiness": { "type": "null" },
            "infra": { "type": "null" },
            "secret_driver": { "type": "null" },
            "volume_uid": { "type": "null" },
            "volume_gid": { "type": "null" }
          }
        }
      ]
    },
    "secret_details": {
      "allOf": [
        { "$ref": "#/$defs/detail_base" },
        {
          "properties": {
            "kind": { "const": "secret" },
            "secret_driver": { "$ref": "#/$defs/field_state" },
            "configured_image": { "type": "null" },
            "local_image_id": { "type": "null" },
            "relationships": { "type": "null" },
            "environment": { "type": "null" },
            "image_aliases": { "type": "null" },
            "network": { "type": "null" },
            "memory_swappiness": { "type": "null" },
            "infra": { "type": "null" },
            "volume_uid": { "type": "null" },
            "volume_gid": { "type": "null" }
          }
        }
      ]
    },
    "details": {
      "oneOf": [
        { "$ref": "#/$defs/container_details" },
        { "$ref": "#/$defs/pod_details" },
        { "$ref": "#/$defs/network_details" },
        { "$ref": "#/$defs/volume_details" },
        { "$ref": "#/$defs/image_details" },
        { "$ref": "#/$defs/secret_details" }
      ]
    },
    "observation_header": {
      "type": "object",
      "required": [
        "identity",
        "state",
        "unmodelled_completeness",
        "unmodelled_fields",
        "findings",
        "evidence"
      ],
      "properties": {
        "identity": { "$ref": "#/$defs/identity" },
        "state": { "enum": ["complete", "unavailable", "malformed"] },
        "unmodelled_completeness": { "enum": ["complete", "incomplete"] },
        "unmodelled_fields": { "type": "array", "items": { "$ref": "#/$defs/unmodelled_field" } },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/inventory_finding" } },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["header", "details"],
      "properties": {
        "header": { "$ref": "#/$defs/observation_header" },
        "details": { "$ref": "#/$defs/details" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "header": {
                "properties": { "identity": { "properties": { "kind": { "const": "container" } } } }
              }
            }
          },
          "then": {
            "properties": { "details": { "properties": { "kind": { "const": "container" } } } }
          }
        },
        {
          "if": {
            "properties": {
              "header": {
                "properties": { "identity": { "properties": { "kind": { "const": "pod" } } } }
              }
            }
          },
          "then": { "properties": { "details": { "properties": { "kind": { "const": "pod" } } } } }
        },
        {
          "if": {
            "properties": {
              "header": {
                "properties": { "identity": { "properties": { "kind": { "const": "network" } } } }
              }
            }
          },
          "then": {
            "properties": { "details": { "properties": { "kind": { "const": "network" } } } }
          }
        },
        {
          "if": {
            "properties": {
              "header": {
                "properties": { "identity": { "properties": { "kind": { "const": "volume" } } } }
              }
            }
          },
          "then": {
            "properties": { "details": { "properties": { "kind": { "const": "volume" } } } }
          }
        },
        {
          "if": {
            "properties": {
              "header": {
                "properties": { "identity": { "properties": { "kind": { "const": "image" } } } }
              }
            }
          },
          "then": {
            "properties": { "details": { "properties": { "kind": { "const": "image" } } } }
          }
        },
        {
          "if": {
            "properties": {
              "header": {
                "properties": { "identity": { "properties": { "kind": { "const": "secret" } } } }
              }
            }
          },
          "then": {
            "properties": { "details": { "properties": { "kind": { "const": "secret" } } } }
          }
        }
      ]
    },
    "inventory_section": {
      "type": "object",
      "required": ["kind", "availability", "findings", "observations"],
      "properties": {
        "kind": { "$ref": "#/$defs/resource_kind" },
        "availability": { "enum": ["available", "unavailable", "malformed"] },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/inventory_finding" } },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } }
      },
      "additionalProperties": false
    },
    "inventory": {
      "type": "object",
      "required": ["schema_version", "service", "sections"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "service": { "$ref": "#/$defs/service" },
        "sections": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/inventory_section" },
                { "properties": { "kind": { "const": "container" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/inventory_section" },
                { "properties": { "kind": { "const": "pod" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/inventory_section" },
                { "properties": { "kind": { "const": "network" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/inventory_section" },
                { "properties": { "kind": { "const": "volume" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/inventory_section" },
                { "properties": { "kind": { "const": "image" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/inventory_section" },
                { "properties": { "kind": { "const": "secret" } } }
              ]
            }
          ],
          "items": false
        }
      },
      "additionalProperties": false
    },
    "dependency_evidence": {
      "type": "object",
      "required": ["kind", "field_paths"],
      "properties": {
        "kind": { "const": "native_relationship" },
        "field_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "required": ["dependent", "prerequisite", "evidence"],
      "properties": {
        "dependent": { "$ref": "#/$defs/identity" },
        "prerequisite": { "$ref": "#/$defs/identity" },
        "evidence": { "$ref": "#/$defs/dependency_evidence" }
      },
      "additionalProperties": false
    },
    "grouping_edge": {
      "type": "object",
      "required": ["left", "right", "evidence", "field_paths"],
      "properties": {
        "left": { "$ref": "#/$defs/identity" },
        "right": { "$ref": "#/$defs/identity" },
        "evidence": { "enum": ["pod_membership", "container_dependency", "compose_ownership"] },
        "field_paths": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "discovery_finding": {
      "type": "object",
      "required": ["code", "resource", "selector", "label_selector", "field_path"],
      "properties": {
        "code": { "type": "string", "pattern": "^PLN[0-9]{4}$" },
        "resource": { "anyOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
        "selector": { "anyOf": [{ "$ref": "#/$defs/resource_selector" }, { "type": "null" }] },
        "label_selector": { "anyOf": [{ "$ref": "#/$defs/label_selector" }, { "type": "null" }] },
        "field_path": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "root_origin": {
      "type": "object",
      "required": ["kind", "position"],
      "properties": {
        "kind": { "enum": ["resource_selector", "label_selector", "all"] },
        "position": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "explanation": {
      "type": "object",
      "required": ["kind", "resource", "related", "position", "root_origin"],
      "properties": {
        "kind": {
          "enum": [
            "root",
            "included_member",
            "prerequisite",
            "stopped_shared_boundary",
            "authorized_network_crossing",
            "authorized_shared_crossing",
            "strong_evidence_merge",
            "group_ordering"
          ]
        },
        "resource": { "$ref": "#/$defs/identity" },
        "related": { "anyOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
        "position": { "type": ["integer", "null"], "minimum": 0 },
        "root_origin": { "anyOf": [{ "$ref": "#/$defs/root_origin" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": ["id", "members", "prerequisites"],
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "members": { "type": "array", "items": { "$ref": "#/$defs/identity" } },
        "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/identity" } }
      },
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "required": [
        "schema_version",
        "requested_roots",
        "requested_label_roots",
        "all_requested",
        "resolved_roots",
        "groups",
        "shared_prerequisites",
        "dependencies",
        "grouping_edges",
        "findings",
        "explanations"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "requested_roots": { "type": "array", "items": { "$ref": "#/$defs/resource_selector" } },
        "requested_label_roots": { "type": "array", "items": { "$ref": "#/$defs/label_selector" } },
        "all_requested": { "type": "boolean" },
        "resolved_roots": { "type": "array", "items": { "$ref": "#/$defs/identity" } },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
        "shared_prerequisites": { "type": "array", "items": { "$ref": "#/$defs/identity" } },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
        "grouping_edges": { "type": "array", "items": { "$ref": "#/$defs/grouping_edge" } },
