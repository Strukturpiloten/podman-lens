{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PodmanLens: Validation plan",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/scripts/validation-plan.py", "plan", "--event", "local"],
      "problemMatcher": []
    },
    {
      "label": "PodmanLens: Validate changes",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/scripts/validation-plan.py", "run-local"],
      "problemMatcher": "$rustc",
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "PodmanLens: Full validation",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/scripts/validation-plan.py", "run-local", "--full"],
      "problemMatcher": "$rustc"
    },
    {
      "label": "PodmanLens: Format, lint, and test all",
      "type": "process",
      "command": "${workspaceFolder}/scripts/check-all.sh",
      "problemMatcher": "$rustc"
    },
    {
      "label": "PodmanLens: Format non-Rust files",
      "type": "process",
      "command": "${workspaceFolder}/scripts/check-files.sh",
      "args": ["--fix"],
      "problemMatcher": []
    },
    {
      "label": "PodmanLens: Format check",
      "type": "process",
      "command": "cargo",
      "args": ["fmt", "--all", "--", "--check"],
      "problemMatcher": []
    },
    {
      "label": "PodmanLens: Check",
      "type": "process",
      "command": "cargo",
      "args": ["ci-check"],
      "problemMatcher": "$rustc"
    },
    {
      "label": "PodmanLens: Policy",
      "type": "process",
      "command": "cargo",
      "args": ["ci-policy"],
      "problemMatcher": "$rustc"
    },
    {
      "label": "PodmanLens: Clippy",
      "type": "process",
      "command": "cargo",
      "args": ["ci-clippy"],
      "problemMatcher": "$rustc"
    },
    {
      "label": "PodmanLens: Test",
      "type": "process",
      "command": "cargo",
      "args": ["ci-test"],
      "problemMatcher": "$rustc"
    },
    {
      "label": "PodmanLens: Doctest",
      "type": "process",
      "command": "cargo",
      "args": ["ci-doctest"],
      "problemMatcher": "$rustc"
    },
    {
      "label": "PodmanLens: Documentation",
      "type": "process",
      "command": "cargo",
      "args": ["ci-doc"],
      "options": { "env": { "RUSTDOCFLAGS": "-D warnings" } },
      "problemMatcher": "$rustc"
    }
  ]
}
